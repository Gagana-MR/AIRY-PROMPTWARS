# AIRY — Environment Configuration Example

# Port for local development server
PORT=5173

# Optional AI API Key (Google Gemini API)
# Airy runs 100% out of the box with its built-in intelligent knowledge & reasoning engine.
# If you want to connect Google Gemini 1.5 Flash for conversational flexibility:
# 1. Obtain a free key from https://aistudio.google.com/
# 2. Add it below (never commit your live keys to public repos)
AIRY_AI_KEY=
GEMINI_API_KEY=
